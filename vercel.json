{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "public": false,
  "github": {
    "enabled": false,
    "silent": true
  },
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/health", "destination": "/api/health" },
    { "source": "/test", "destination": "/api/test" },
    { "source": "/api", "destination": "/api/api" },
    { "source": "/up", "destination": "/api/up" },
    { "source": "/season", "destination": "/api/season" },
    { "source": "/download", "destination": "/api/download" }
  ],
  "functions": {
    "api/[...path].js": {
      "memory": 128,
      "maxDuration": 30
    }
  }
}
