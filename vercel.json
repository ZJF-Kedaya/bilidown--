{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/health", "destination": "/api/health" },
    { "source": "/test", "destination": "/api/test" },
    { "source": "/api", "destination": "/api/api" },
    { "source": "/up", "destination": "/api/up" },
    { "source": "/season", "destination": "/api/season" },
    { "source": "/dynamic", "destination": "/api/dynamic" },
    { "source": "/download", "destination": "/api/download" }
  ]
}
